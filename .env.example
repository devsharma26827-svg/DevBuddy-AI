# ProjectPilot AI - Environment Variables Template

# Application Environment (development / production)
ENVIRONMENT=development

# Centralized Gemini Model Configuration
# Fallback models (gemini-2.5-pro, gemini-2.0-flash) are automatically selected on error
GEMINI_MODEL=gemini-2.5-flash

# Individual Agent Gemini API Keys
# If one key fails, the remaining agents will continue using their respective keys
GEMINI_KEY_AGENT_1=your_gemini_key_for_agent_1_here
GEMINI_KEY_AGENT_2=your_gemini_key_for_agent_2_here
GEMINI_KEY_AGENT_3=your_gemini_key_for_agent_3_here
GEMINI_KEY_AGENT_4=your_gemini_key_for_agent_4_here
GEMINI_KEY_AGENT_5=your_gemini_key_for_agent_5_here

# Global Fallback Gemini API Key
GEMINI_API_KEY=your_global_gemini_api_key_here

# GitHub Access Token (Required for the GitHub Deployment Agent)
GITHUB_TOKEN=your_github_personal_access_token_here

# LinkedIn API Credentials (Placeholder - Client details)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
